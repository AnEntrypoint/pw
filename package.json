{
  "name": "pw",
  "version": "0.1.0",
  "private": true,
  "description": "playwriter with one Chrome profile per project, started on first use and stopped after idle.",
  "bin": {
    "playwriter-project": "bin/playwriter-project"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test": "node test/patch.cjs && node test/tools.cjs && node test/lifecycle.cjs && node test/leases.cjs && node test/signals.cjs && node test/fallback.cjs && node test/ready.cjs && node test/stale.cjs && node test/start.cjs && node test/signal.cjs && node test/callprobe.cjs && node test/negative-control.cjs && node test/live-browser.cjs && node test/executor.cjs direct && node test/executor.cjs headless && node test/giveup.cjs && node test/close-noop.cjs && node test/close-refusals.cjs",
    "witness": "node test/memory.cjs",
    "f1": "node test/firstpage.cjs",
    "orphan": "node test/orphan.cjs",
    "mode": "node test/mode.cjs",
    "signals": "node test/signals.cjs",
    "fallback": "node test/fallback.cjs",
    "ready": "node test/ready.cjs",
    "phase-b": "node test/phase-b.cjs",
    "stale-replace": "node test/stale.cjs replace",
    "stale-held": "node test/stale.cjs held",
    "stale-unanswering": "node test/stale.cjs unanswering",
    "stale-foreign": "node test/stale.cjs foreign",
    "start-refusal": "node test/start.cjs",
    "signal": "node test/signal.cjs",
    "callprobe": "node test/callprobe.cjs",
    "negative-control": "node test/negative-control.cjs",
    "start-poll-refuse": "node test/start-poll.cjs refuse",
    "start-poll-ready": "node test/start-poll.cjs ready",
    "lifecycle-forced-check11": "node test/lifecycle-forced.cjs check11",
    "lifecycle-forced-cleanup": "node test/lifecycle-forced.cjs cleanup",
    "live-browser": "node test/live-browser.cjs",
    "executor-direct": "node test/executor.cjs direct",
    "executor-headless": "node test/executor.cjs headless",
    "giveup": "node test/giveup.cjs",
    "close-noop": "node test/close-noop.cjs",
    "close-refusals": "node test/close-refusals.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "patch-package": "8.0.1",
    "playwriter": "0.9.0"
  }
}
