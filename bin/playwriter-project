#!/usr/bin/env node
const fs = require('node:fs');
const net = require('node:net');
const http = require('node:http');
const path = require('node:path');
const crypto = require('node:crypto');
const { pathToFileURL } = require('node:url');
const { spawn, execFile, execFileSync } = require('node:child_process');
const { listBrowsers, browserLines, browserReport } = require('../lib/browsers');

let PLAYWRITER_DIR;
try {
  PLAYWRITER_DIR = path.dirname(require.resolve('playwriter/package.json'));
} catch {
  console.error('playwriter-project: playwriter is not installed next to this package. Run npm install in the package folder.');
  process.exit(1);
}
const PLAYWRITER_BIN = path.join(PLAYWRITER_DIR, 'bin.js');

const HOST = '127.0.0.1';
const IDLE_MS = Number(process.env.PLAYWRITER_IDLE_MS) || 300000;
const GRACE_MS = 5000;
const CHROME_TRIMS = [
  '--disable-extensions',
  '--disable-background-networking',
  '--disable-component-update',
  '--disable-default-apps',
  '--disable-sync',
  '--disable-breakpad',
  '--disable-dev-shm-usage',
  '--metrics-recording-only',
  '--mute-audio',
  '--no-service-autorun',
  '--password-store=basic',
  '--use-mock-keychain',
  '--disable-features=Translate,OptimizationHints,MediaRouter,DialMediaRouteProvider,AcceptCHFrame,ImprovedCookieControls',
  '--process-per-site',
  '--renderer-process-limit=1',
];
const IDLE_CHECK_MS = 2000;
const GONE_AFTER_PROBES = 3;
const CHILD_EXIT_MS = 1500;
const HOP_BY_HOP = ['connection', 'keep-alive', 'transfer-encoding', 'content-length'];
const INIT_ID = 'pwp-init';
const MCP_TOOLS = require('../lib/mcp-tools.json');

function findUp(start, name) {
  for (let dir = start; ; dir = path.dirname(dir)) {
    if (fs.existsSync(path.join(dir, name))) return dir;
    if (path.dirname(dir) === dir) return null;
  }
}

function projectRoot(cwd) {
  if (process.env.PLAYWRITER_PROJECT_DIR) return path.resolve(process.env.PLAYWRITER_PROJECT_DIR);
  return findUp(cwd, '.playwriter') || findUp(cwd, '.git') || cwd;
}

const PROJECT = projectRoot(process.cwd());
const STATE = path.join(PROJECT, '.playwriter');
const PROFILE = path.join(STATE, 'browser-profile');
const GATE_LOG = path.join(STATE, 'gate.log');
const BROWSER_LOG = path.join(STATE, 'browser.log');
const LINUX_BROWSERS = ['/opt/google/chrome/chrome', '/usr/lib/chromium/chromium.real'];
const BROWSER_PID = path.join(STATE, 'browser.pid');
const WEBGPU_LABS = ['enable-unsafe-webgpu', 'enable-vulkan@1', 'enable-webgpu-developer-features'];

const USAGE = [
  'usage: playwriter-project [start | status [--json] | session [flags] | help | playwriter-args...]',
  '  (no args)  playwriter MCP server bound to this project browser (use in .mcp.json); each tool result ends with a status block',
  '  start      open this project browser and check it answers; it stays up while a session holds a lease, a page is open, or for the idle time',
  '  status     show the gate, every Chromium browser on this machine, and the pages of this project; --json prints JSON',
  '  session    create a CLI session bound to this project browser',
  '  <args>     run `playwriter <args>` bound to this project browser',
  'install:    npx -y add-mcp "npx -y github:AnEntrypoint/pw" -n playwriter --all -g -y',
  'env:        PLAYWRITER_PROJECT_DIR (default: nearest ancestor of cwd with .playwriter, else with .git, else cwd),',
  '            PLAYWRITER_BROWSER_PATH, PLAYWRITER_NO_SANDBOX=1,',
  '            PLAYWRITER_WEBGPU=1 turns on the WebGPU labs in this project profile before Chromium starts, fresh or not,',
  `            PLAYWRITER_IDLE_MS (default ${IDLE_MS}: browser stops after this long with no traffic)`,
].join('\n');

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const logTail = (file) => {
  try {
    return fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).slice(-6).join(' | ') || '(empty)';
  } catch {
    return '(no log)';
  }
};
const log = (line) => fs.appendFileSync(GATE_LOG, `${new Date().toISOString()} ${line}\n`);
const browserFingerprint = () => [process.env.PLAYWRITER_BROWSER_PATH || LINUX_BROWSERS.find((candidate) => fs.existsSync(candidate)) || '', process.env.PLAYWRITER_NO_SANDBOX ? 'no-sandbox' : '', process.env.PLAYWRITER_WEBGPU === '1' ? 'webgpu' : ''].join('|');
const isCallerPage = (target) => target.type === 'page' && !target.url.startsWith('about:') && !target.url.startsWith('chrome://') && !target.url.startsWith('devtools://');
const playwriterSpawn = (args, options = {}) => spawn(process.execPath, [PLAYWRITER_BIN, ...args], { cwd: PROJECT, ...options });

function httpGet(port, urlPath, timeout = 3000) {
  return new Promise((resolve) => {
    const req = http.get({ host: HOST, port, path: urlPath, timeout }, (res) => {
      const chunks = [];
      res.on('data', (chunk) => chunks.push(chunk));
      res.on('end', () => resolve({ status: res.statusCode, body: Buffer.concat(chunks).toString('utf8') }));
      res.on('error', () => resolve(null));
    });
    req.on('error', () => resolve(null));
    req.on('timeout', () => {
      req.destroy();
      resolve(null);
    });
  });
}

async function httpOk(port, urlPath, timeout) {
  return (await httpGet(port, urlPath, timeout))?.status === 200;
}

async function httpJson(port, urlPath, timeout) {
  const res = await httpGet(port, urlPath, timeout);
  if (res?.status !== 200) return null;
  try {
    return JSON.parse(res.body);
  } catch {
    return null;
  }
}

async function waitFor(check, ms) {
  const end = Date.now() + ms;
  while (Date.now() < end) {
    if (await check()) return true;
    await sleep(200);
  }
  return false;
}

function browserLogTail(from) {
  const text = fs.readFileSync(BROWSER_LOG).subarray(from).toString('utf8');
  const handoff = text.includes('Opening in existing browser session') ? 'the launcher handed off to an already-running Chromium' : 'no handoff line in browser.log';
  const tail = text.split('\n').filter(Boolean).slice(-8).join(' | ');
  return handoff + '; log tail: ' + tail;
}

function portFree(port) {
  return new Promise((resolve) => {
    const probe = net.createServer();
    probe.once('error', () => resolve(false));
    probe.listen(port, HOST, () => probe.close(() => resolve(true)));
  });
}

async function pickPort(base, span, offset) {
  for (let i = 0; i < span; i++) {
    const port = base + ((offset + i) % span);
    if (await portFree(port)) return port;
  }
  throw new Error(`no free port in ${base}-${base + span - 1}`);
}

function readPorts() {
  const read = (name) => {
    try {
      return Number(fs.readFileSync(path.join(STATE, name), 'utf8')) || 0;
    } catch {
      return 0;
    }
  };
  return { gate: read('port'), debug: read('debug-port') };
}

async function loadPorts() {
  fs.mkdirSync(STATE, { recursive: true });
  let { gate, debug } = readPorts();
  if (!gate || !debug) {
    const offset = crypto.createHash('sha1').update(PROJECT).digest().readUInt32BE(0) % 500;
    gate ||= await pickPort(9400, 500, offset);
    debug ||= await pickPort(9900, 500, offset);
    gate = claimPort('port', gate);
    debug = claimPort('debug-port', debug);
  }
  return { gate, debug };
}

function claimPort(name, value) {
  const file = path.join(STATE, name);
  const tmp = `${file}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, `${value}\n`);
  try {
    fs.linkSync(tmp, file);
  } catch (error) {
    if (error.code !== 'EEXIST') throw error;
  } finally {
    fs.rmSync(tmp, { force: true });
  }
  return Number(fs.readFileSync(file, 'utf8')) || value;
}

function readRecordedPid() {
  try {
    return Number(fs.readFileSync(BROWSER_PID, 'utf8')) || null;
  } catch {
    return null;
  }
}

function linuxListenerPid(port) {
  const hex = port.toString(16).toUpperCase().padStart(4, '0');
  const inodes = new Set();
  for (const file of ['/proc/net/tcp', '/proc/net/tcp6']) {
    let rows;
    try {
      rows = fs.readFileSync(file, 'utf8').split('\n').slice(1);
    } catch {
      continue;
    }
    for (const row of rows) {
      const cols = row.trim().split(/\s+/);
      if (cols.length > 9 && cols[3] === '0A' && cols[1].endsWith(`:${hex}`)) inodes.add(cols[9]);
    }
  }
  if (inodes.size === 0) return null;
  for (const entry of fs.readdirSync('/proc')) {
    if (!/^\d+$/.test(entry)) continue;
    let fds;
    try {
      fds = fs.readdirSync(`/proc/${entry}/fd`);
    } catch {
      continue;
    }
    for (const fd of fds) {
      let target;
      try {
        target = fs.readlinkSync(`/proc/${entry}/fd/${fd}`);
      } catch {
        continue;
      }
      const match = /^socket:\[(\d+)\]$/.exec(target);
      if (match && inodes.has(match[1])) return Number(entry);
    }
  }
  return null;
}

function listenerPid(port) {
  if (process.platform === 'linux') return linuxListenerPid(port);
  if (process.platform === 'darwin') {
    try {
      const out = execFileSync('lsof', ['-nP', `-iTCP:${port}`, '-sTCP:LISTEN', '-t'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
      return Number(out.split('\n')[0]) || null;
    } catch {
      return null;
    }
  }
  return null;
}

function pidAlive(pid) {
  try {
    process.kill(pid, 0);
  } catch (error) {
    return error.code === 'EPERM';
  }
  const state = process.platform === 'linux' ? readRaw(`/proc/${pid}/stat`)?.split(') ')[1]?.[0] : null;
  return state !== 'Z' && state !== 'X';
}

function readRaw(file) {
  try {
    return fs.readFileSync(file, 'utf8');
  } catch {
    return null;
  }
}

function liveProfileOwner() {
  let lock;
  try {
    lock = fs.readlinkSync(path.join(PROFILE, 'SingletonLock'));
  } catch {
    return null;
  }
  const pid = Number(/-(\d+)$/.exec(lock)?.[1]) || null;
  return pid !== null && pidAlive(pid) ? pid : null;
}

function resolveFromConfig() {
  const url = pathToFileURL(path.join(PLAYWRITER_DIR, 'dist', 'browser-config.js')).href;
  const script = "import(process.argv[1]).then((config) => process.stdout.write(config.resolveBrowserExecutablePath()), (error) => { process.stderr.write(error.message); process.exit(1); });";
  return new Promise((resolve, reject) => {
    execFile(process.execPath, ['-e', script, url], { env: process.env, encoding: 'utf8' }, (error, stdout, stderr) => {
      if (error) return reject(new Error((stderr || error.message).trim()));
      resolve(stdout.trim());
    });
  });
}

async function resolveBrowser() {
  if (process.platform === 'linux' && !process.env.PLAYWRITER_BROWSER_PATH) {
    const preferred = LINUX_BROWSERS.find((candidate) => fs.existsSync(candidate));
    if (preferred) process.env.PLAYWRITER_BROWSER_PATH = preferred;
  }
  try {
    return await resolveFromConfig();
  } catch (error) {
    log(`no browser found (${error.message}): running playwriter browser install`);
    const out = fs.openSync(BROWSER_LOG, 'a');
    const code = await new Promise((resolve) => {
      const child = playwriterSpawn(['browser', 'install'], { stdio: ['ignore', out, out] });
      child.on('error', () => resolve(1));
      child.on('exit', (exitCode) => resolve(exitCode ?? 1));
    });
    fs.closeSync(out);
    if (code !== 0) throw new Error(`browser install failed (exit ${code}); see ${BROWSER_LOG}: ${logTail(BROWSER_LOG)}`);
    return resolveFromConfig();
  }
}

function seedLabs(profile, labs) {
  fs.mkdirSync(profile, { recursive: true });
  const file = path.join(profile, 'Local State');
  let state = {};
  if (fs.existsSync(file)) {
    try {
      state = JSON.parse(fs.readFileSync(file, 'utf8'));
    } catch (error) {
      throw new Error(`cannot seed the WebGPU labs: ${file} is not JSON (${error.message})`);
    }
  }
  const browser = state.browser && typeof state.browser === 'object' ? state.browser : {};
  const before = Array.isArray(browser.enabled_labs_experiments) ? browser.enabled_labs_experiments : [];
  const labsOn = [...before, ...labs.filter((flag) => !before.includes(flag))];
  if (labsOn.length === before.length && fs.existsSync(file)) return false;
  fs.writeFileSync(file, JSON.stringify({ ...state, browser: { ...browser, enabled_labs_experiments: labsOn } }));
  log(`seeded WebGPU labs into ${file}`);
  return true;
}

function runGate({ gate, debug }) {
  const leaseHolders = new Map();
  let leaseSeq = 0;
  let lastActivity = Date.now();
  let chromeUp = false;
  let missedProbes = 0;
  let chromeProc = null;
  let browser = null;
  let starting = null;
  let stopping = null;
  const sockets = new Set();
  let everLeased = false;
  let graceTimer = null;
  let lastLeaseEvent = Date.now();
  let holdUntil = 0;
  const totalBusy = () => [...leaseHolders.values()].reduce((sum, lease) => sum + lease.busy, 0);

  const touch = () => {
    lastActivity = Date.now();
  };
  const probe = () => httpOk(debug, '/json/version');
  const gone = async () => !(await probe());
  const dropSockets = () => {
    for (const socket of sockets) socket.destroy();
    sockets.clear();
  };
  const fail = (res, error) => {
    if (res.headersSent) return res.destroy();
    res.writeHead(503, { 'content-type': 'text/plain' });
    res.end(error.message);
  };
  const clean = (headers) => Object.fromEntries(Object.entries(headers).filter(([key]) => !HOP_BY_HOP.includes(key)));

  const pageList = async () => ((await httpJson(debug, '/json/list', 3000)) ?? [])
    .filter((target) => target.type === 'page')
    .map(({ id, title, url }) => ({ id, title, url }));

  const statusPayload = async ({ pages = true } = {}) => {
    const running = await probe();
    return {
      project: PROJECT,
      gate: { pid: process.pid, port: gate },
      debugPort: debug,
      profile: PROFILE,
      browser: {
        pid: browser?.pid ?? null,
        running,
        source: browser?.source ?? null,
        adopted: browser?.adopted ?? false,
        warning: browser?.warning ?? null,
      },
      leases: leaseHolders.size,
      leaseHolders: [...leaseHolders.values()],
      closeVerb: true,
      pages: running && pages ? await pageList() : [],
    };
  };

  const startChrome = async () => {
    fs.mkdirSync(PROFILE, { recursive: true });
    const owner = liveProfileOwner();
    if (owner) {
      log(`start deferred: profile lock held by live pid ${owner}`);
      if (await waitFor(probe, 30000)) return adopt();
      throw new Error(`profile ${PROFILE} is held by live pid ${owner}, which does not answer on port ${debug}; not starting another browser`);
    }
    if (process.env.PLAYWRITER_WEBGPU === '1') seedLabs(PROFILE, WEBGPU_LABS);
    const bin = await resolveBrowser();
    const args = [
      `--user-data-dir=${PROFILE}`,
      `--remote-debugging-port=${debug}`,
      '--no-first-run',
      '--no-default-browser-check',
      ...CHROME_TRIMS,
    ];
    if (process.env.PLAYWRITER_WEBGPU !== '1') args.push('--disable-gpu');
    if (process.platform === 'linux' && !process.env.DISPLAY && !process.env.WAYLAND_DISPLAY) args.push('--headless=new');
    if (process.env.PLAYWRITER_NO_SANDBOX) args.push('--no-sandbox');
    args.push('about:blank');
    fs.appendFileSync(BROWSER_LOG, '');
    const from = fs.statSync(BROWSER_LOG).size;
    const out = fs.openSync(BROWSER_LOG, 'a');
    let exited = null;
    chromeProc = spawn(bin, args, { detached: true, stdio: ['ignore', out, out] });
    chromeProc.on('error', (error) => log(`browser spawn error: ${error.message}`));
    chromeProc.once('exit', (code, signal) => { exited = code ?? signal; });
    chromeProc.unref();
    fs.closeSync(out);
    log(`browser started pid=${chromeProc.pid} profile=${PROFILE}`);
    const refused = () => fs.readFileSync(BROWSER_LOG).subarray(from).includes('No usable sandbox');
    await waitFor(async () => (await probe()) || refused() || exited !== null, 30000);
    if (await probe()) {
      const pid = listenerPid(debug) ?? (pidAlive(chromeProc.pid) ? chromeProc.pid : null);
      if (pid === null) throw new Error(`browser answered on port ${debug} but its pid could not be read; see ${BROWSER_LOG}`);
      const owner = liveProfileOwner();
      if (owner !== null && owner !== pid) {
        browser = { pid, source: 'adopted', adopted: true, warning: `browser pid ${pid} on debug port ${debug} is not the browser this gate started (pid ${owner}); it was not stopped` };
        return;
      }
      fs.writeFileSync(BROWSER_PID, `${pid}\n`);
      browser = { pid, source: 'gate', adopted: false, warning: null };
      return;
    }
    if (refused()) {
      throw new Error('browser refused to start: no usable sandbox. Set PLAYWRITER_NO_SANDBOX=1 and restart the agent (manual, chapter 9).');
    }
    if (exited !== null) throw new Error(`browser exited (${exited}) before opening debug port ${debug}: ${browserLogTail(from)}`);
    throw new Error(`browser did not open debug port ${debug}; see ${BROWSER_LOG}: ${logTail(BROWSER_LOG)}`);
  };

  const adopt = () => {
    const pid = listenerPid(debug);
    const recorded = readRecordedPid();
    const adopted = pid === null || pid !== recorded;
    const warning = adopted
      ? `browser pid ${pid ?? 'unknown'} on debug port ${debug} is not the recorded pid ${recorded ?? 'none'}; it was not stopped, and another browser may share this project`
      : null;
    browser = { pid, source: 'adopted', adopted, warning };
    log(`adopted running browser${pid ? ` pid=${pid}` : ''}`);
    if (warning) log(`WARNING ${warning}`);
  };

  const ensureChrome = async () => {
    if (stopping) await stopping;
    if (chromeUp && await probe()) return;
    if (chromeUp) {
      chromeUp = false;
      browser = null;
      missedProbes = 0;
      dropSockets();
      log('browser stopped answering; starting it again');
    }
    starting ??= (async () => {
      if (await probe()) adopt();
      else await startChrome();
      chromeUp = true;
      missedProbes = 0;
    })().finally(() => {
      starting = null;
    });
    return starting;
  };

  const closeBrowser = async () => {
    const info = await fetch(`http://${HOST}:${debug}/json/version`).then((res) => res.json()).catch(() => null);
    if (!info?.webSocketDebuggerUrl) return;
    await new Promise((resolve) => {
      const ws = new WebSocket(info.webSocketDebuggerUrl);
      ws.onopen = () => ws.send(JSON.stringify({ id: 1, method: 'Browser.close' }));
      ws.onclose = resolve;
      ws.onerror = resolve;
      setTimeout(resolve, 5000).unref();
    });
  };

  const stopChrome = (reason = 'idle') => {
    stopping ??= (async () => {
      chromeUp = false;
      log(`stopping browser: ${reason}`);
      await closeBrowser();
      if (!(await waitFor(gone, 10000))) {
        if (chromeProc) chromeProc.kill('SIGTERM');
        await waitFor(gone, 5000);
      }
      dropSockets();
      browser = null;
      fs.rmSync(BROWSER_PID, { force: true });
      log('browser stopped');
    })().finally(() => {
      stopping = null;
    });
    return stopping;
  };

  const isHeld = async () => {
    if (!chromeUp || !(await probe())) return false;
    if (Date.now() < holdUntil) return true;
    return ((await httpJson(debug, '/json/list', 3000)) ?? []).some(isCallerPage);
  };

  const releaseBrowser = async (reason) => {
    if (!chromeUp) return;
    if (browser?.adopted) {
      chromeUp = false;
      browser = null;
      return;
    }
    await stopChrome(reason);
  };

  const exitUnleased = async () => {
    graceTimer = null;
    if (leaseHolders.size > 0) return;
    if (await isHeld()) {
      log('no lease, but a start hold or an open page keeps the browser up');
      return;
    }
    await releaseBrowser('no lease for the grace period');
    log('gate exiting: no lease for the grace period');
    process.exit(0);
  };

  const leaseEmptied = () => {
    log('last lease released');
    graceTimer ??= setTimeout(exitUnleased, GRACE_MS);
  };

  const closeFromCaller = async (params) => {
    const wanted = params.get('pid');
    const others = [...leaseHolders.values()].filter((lease) => String(lease.pid) !== params.get('self'));
    if (!browser || !(await probe())) return { closed: false, reason: 'no browser is running for this project' };
    if (browser.adopted) return { closed: false, pid: browser.pid, reason: `browser pid ${browser.pid} was adopted; this gate did not start it, so it is not closed` };
    if (wanted && Number(wanted) !== browser.pid) return { closed: false, pid: browser.pid, reason: `pid ${wanted} is not this project's browser, which is pid ${browser.pid}` };
    if (others.length && params.get('force') !== '1') return { closed: false, pid: browser.pid, reason: `${others.length} other lease(s) held`, leases: others };
    const { pid } = browser;
    await stopChrome('closed by the browsers tool');
    return { closed: true, pid };
  };

  const proxyHttp = (req, res) => {
    const up = http.request(
      { host: HOST, port: debug, method: req.method, path: req.url, headers: { ...req.headers, host: `${HOST}:${debug}` } },
      (upRes) => {
        touch();
        if (!(upRes.headers['content-type'] || '').includes('json')) {
          res.writeHead(upRes.statusCode, clean(upRes.headers));
          return upRes.pipe(res);
        }
        const chunks = [];
        upRes.on('data', (chunk) => chunks.push(chunk));
        upRes.on('end', () => {
          const body = Buffer.concat(chunks).toString('utf8')
            .replaceAll(`${HOST}:${debug}`, `${HOST}:${gate}`)
            .replaceAll(`localhost:${debug}`, `localhost:${gate}`);
          res.writeHead(upRes.statusCode, { ...clean(upRes.headers), 'content-length': Buffer.byteLength(body) });
          res.end(body);
        });
      },
    );
    up.on('error', (error) => fail(res, error));
    req.pipe(up);
  };

  const proxyUpgrade = (req, socket, head) => {
    const up = net.connect(debug, HOST);
    sockets.add(up);
    sockets.add(socket);
    const lines = [`${req.method} ${req.url} HTTP/${req.httpVersion}`];
    for (let i = 0; i < req.rawHeaders.length; i += 2) {
      const name = req.rawHeaders[i];
      lines.push(name.toLowerCase() === 'host' ? `Host: ${HOST}:${debug}` : `${name}: ${req.rawHeaders[i + 1]}`);
    }
    up.write(`${lines.join('\r\n')}\r\n\r\n`);
    if (head.length) up.write(head);
    const end = () => {
      sockets.delete(up);
      sockets.delete(socket);
      up.destroy();
      socket.destroy();
    };
    up.on('error', end);
    up.on('close', end);
    socket.on('error', end);
    socket.on('close', end);
    up.on('data', touch);
    socket.on('data', touch);
    socket.pipe(up);
    up.pipe(socket);
  };

  const currentBrowserPath = async () => {
    const info = await fetch(`http://${HOST}:${debug}/json/version`).then((res) => res.json());
    return new URL(info.webSocketDebuggerUrl).pathname;
  };

  const respondJson = (res, body) => body.then(
    (payload) => {
      res.writeHead(200, { 'content-type': 'application/json' });
      res.end(JSON.stringify(payload));
    },
    (error) => fail(res, error),
  );

  const server = http.createServer((req, res) => {
    const [route, query = ''] = req.url.split('?');
    const params = new URLSearchParams(query);
    if (route === '/__pwp/ping') return res.end(JSON.stringify({ project: PROJECT, pid: process.pid }));
    if (route === '/__pwp/status') return respondJson(res, statusPayload({ pages: params.get('pages') !== '0' }));
    if (route === '/__pwp/close' && req.method === 'POST') return respondJson(res, closeFromCaller(params));
    if (route === '/__pwp/lease') {
      const id = ++leaseSeq;
      leaseHolders.set(id, { pid: Number(req.headers['x-pwp-pid']) || null, since: Date.now(), busy: 0 });
      everLeased = true;
      lastLeaseEvent = Date.now();
      clearTimeout(graceTimer);
      graceTimer = null;
      res.on('close', () => {
        leaseHolders.delete(id);
        lastLeaseEvent = Date.now();
        if (leaseHolders.size === 0) leaseEmptied();
      });
      return res.write(`leased ${id}\n`);
    }
    if (route === '/__pwp/hold') {
      holdUntil = Math.max(holdUntil, Date.now() + (Number(params.get('ms')) || IDLE_MS));
      return res.end('ok\n');
    }
    if (route === '/__pwp/busy') {
      const lease = leaseHolders.get(Number(params.get('id')));
      if (lease) {
        lease.busy = Math.max(0, lease.busy + Number(params.get('delta')));
        lastLeaseEvent = Date.now();
        touch();
      }
      return res.end('ok\n');
    }
    touch();
    ensureChrome().then(() => proxyHttp(req, res), (error) => fail(res, error));
  });

  server.on('upgrade', (req, socket, head) => {
    touch();
    ensureChrome()
      .then(() => currentBrowserPath())
      .then((browserPath) => {
        req.url = req.url.replace(/^\/devtools\/browser\/[^/?]*/, browserPath);
        proxyUpgrade(req, socket, head);
      })
      .catch((error) => socket.end(`HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\n\r\n${error.message}`));
  });

  const closeBlankTabs = async () => {
    const pages = ((await httpJson(debug, '/json/list', 3000)) ?? []).filter((target) => target.type === 'page');
    const blank = pages.filter((page) => page.url === 'about:blank');
    if (pages.length > blank.length && blank.length > 0) {
      for (const page of blank) await httpGet(debug, `/json/close/${page.id}`, 3000);
    }
  };

  const tick = async () => {
    if (chromeUp) {
      if (await probe()) {
        missedProbes = 0;
      } else if (++missedProbes >= GONE_AFTER_PROBES) {
        chromeUp = false;
        browser = null;
        missedProbes = 0;
        dropSockets();
        log(`browser went away after ${GONE_AFTER_PROBES} failed probes`);
      } else {
        log(`probe failed ${missedProbes}/${GONE_AFTER_PROBES}`);
      }
    }
    const idle = Date.now() - lastActivity;
    if (chromeUp) await closeBlankTabs();
    if (chromeUp && idle >= IDLE_MS && leaseHolders.size === 0) {
      if (browser?.adopted) {
        chromeUp = false;
        log('released adopted browser without stopping it');
      } else {
        await stopChrome();
      }
    }
    if (chromeUp && leaseHolders.size === 0 && Date.now() - lastLeaseEvent >= GRACE_MS && !(await isHeld())) {
      await releaseBrowser('no lease and no open page');
    }
    if (!everLeased && !chromeUp && leaseHolders.size === 0 && idle >= IDLE_MS) {
      log('gate exiting: never leased, idle');
      process.exit(0);
    }
    if (everLeased && !chromeUp && totalBusy() === 0 && Date.now() - lastLeaseEvent >= GRACE_MS) {
      log('gate exiting: browser down and no call in flight');
      process.exit(0);
    }
  };

  server.on('error', (error) => {
    log(`gate listen failed on ${gate}: ${error.message}`);
    process.exit(0);
  });
  server.listen(gate, HOST, () => log(`gate on ${gate}, browser debug port ${debug}, idle ${IDLE_MS}ms`));
  setInterval(() => {
    tick().catch((error) => log(`tick failed: ${error.message}`));
  }, Math.min(5000, Math.max(200, IDLE_MS / 4)));
}

async function ensureGate(port) {
  const ping = await httpJson(port, '/__pwp/ping', 3000);
  if (ping) {
    if (ping.project === PROJECT) return;
    throw new Error(`port ${port} is the gate for ${ping.project}, not ${PROJECT}. Delete ${path.join(STATE, 'port')} to pick a new port.`);
  }
  const out = fs.openSync(GATE_LOG, 'a');
  const gate = spawn(process.execPath, [__filename, '--gate'], {
    cwd: PROJECT,
    detached: true,
    stdio: ['ignore', out, out],
    env: { ...process.env, PLAYWRITER_PROJECT_DIR: PROJECT },
  });
  gate.unref();
  fs.closeSync(out);
  if (!(await waitFor(() => httpOk(port, '/__pwp/ping'), 5000))) {
    throw new Error(`gate did not start on port ${port}; see ${GATE_LOG}: ${logTail(GATE_LOG)}`);
  }
}

function openLease(port) {
  return new Promise((resolve, reject) => {
    const socket = net.connect(port, HOST);
    let granted = false;
    socket.once('connect', () => {
      socket.write(`GET /__pwp/lease HTTP/1.1\r\nHost: ${HOST}\r\nX-Pwp-Pid: ${process.pid}\r\n\r\n`);
    });
    socket.on('data', (chunk) => {
      const id = /leased (\d+)/.exec(chunk.toString())?.[1];
      if (granted || !id) return;
      granted = true;
      socket.leaseId = Number(id);
      resolve(socket);
    });
    socket.on('error', reject);
    socket.on('close', () => {
      if (!granted) reject(new Error(`gate on port ${port} did not grant a lease`));
    });
  });
}

async function acquireLease(port) {
  for (let attempt = 1; ; attempt++) {
    await ensureGate(port);
    try {
      return await openLease(port);
    } catch (error) {
      if (attempt >= 5) throw error;
      await sleep(300);
    }
  }
}

function gateHeader(status) {
  const { browser: b, gate, debugPort, leases } = status;
  const adopted = b.adopted ? `, ADOPTED: ${b.warning}` : '';
  return `playwriter-project ${status.project}: gate pid ${gate.pid} port ${gate.port}, debug port ${debugPort}, browser ${b.running ? 'running' : 'stopped'} pid ${b.pid ?? '-'} (${b.source ?? 'none'})${adopted}, leases ${leases}`;
}

function feedbackLines(status, machine) {
  const header = status ? gateHeader(status) : 'playwriter-project: no gate status: the gate is not running or not reachable';
  return [header, ...browserLines(machine, PROJECT)];
}

async function feedbackText(gatePort) {
  const [status, machine] = await Promise.all([httpJson(gatePort, '/__pwp/status?pages=0', 1000), listBrowsers()]);
  return feedbackLines(status, machine).join('\n');
}

async function status(json) {
  const { gate: port } = readPorts();
  const ping = port ? await httpJson(port, '/__pwp/ping', 2000) : null;
  if (ping && ping.project !== PROJECT) throw new Error(`port ${port} is the gate for ${ping.project}, not ${PROJECT}`);
  const body = ping ? await httpJson(port, '/__pwp/status', 3000) : null;
  if (ping && !body) throw new Error(`gate on port ${port} predates status; run again after it exits`);
  const machine = await listBrowsers({ fresh: true });
  if (json) return console.log(JSON.stringify({ ...(body ?? { project: PROJECT, gate: null }), browsers: browserReport(machine, PROJECT) }, null, 2));
  const lines = body ? feedbackLines(body, machine) : [`playwriter-project: no gate running for ${PROJECT}`, ...browserLines(machine, PROJECT)];
  console.log(lines.join('\n'));
}

function parseFrame(line) {
  try {
    return JSON.parse(line);
  } catch {
    return null;
  }
}

function lineReader(onLine) {
  let rest = '';
  return {
    push(chunk) {
      rest += chunk;
      let end;
      while ((end = rest.indexOf('\n')) >= 0) {
        onLine(rest.slice(0, end));
        rest = rest.slice(end + 1);
      }
    },
    end() {
      if (rest) onLine(rest);
      rest = '';
    },
  };
}

const BROWSERS_TOOL = {
  name: 'browsers',
  description: 'List the Chromium browsers open on this machine, or close one. action "list" reports every browser and its owner. action "close" closes this project\'s browser with target "project", or a browser this project\'s gate started with target "pid:<n>". Other browsers are refused and named. A close is refused while other leases are held, unless force is true.',
  inputSchema: {
    type: 'object',
    properties: {
      action: { type: 'string', enum: ['list', 'close'] },
      target: { type: 'string', description: '"project" or "pid:<n>"; required for close' },
      force: { type: 'boolean', description: 'close even when other leases are held' },
    },
    required: ['action'],
  },
};

async function closeGate(port, { force, pid }) {
  const status = await httpJson(port, '/__pwp/status?pages=0', 1000);
  if (!status) return { closed: false, reason: 'the gate is not reachable' };
  if (!status.closeVerb) return { closed: false, reason: "this project's gate runs code from before the browsers tool; it is replaced when it goes idle" };
  const params = new URLSearchParams({ self: String(process.pid), force: force ? '1' : '0' });
  if (pid !== undefined) params.set('pid', String(pid));
  try {
    const res = await fetch(`http://${HOST}:${port}/__pwp/close?${params}`, { method: 'POST', signal: AbortSignal.timeout(30000) });
    return await res.json();
  } catch (error) {
    return { closed: false, reason: `close request failed: ${error.message}` };
  }
}

async function closePid(pid, force, port, machine) {
  const hit = machine.browsers.find((browser) => browser.pid === pid);
  if (!hit) return { closed: false, reason: `pid ${pid} is not a running Chromium browser that pw can see` };
  if (hit.project === null) return { closed: false, reason: `pid ${pid} is not started by pw (owner none): a default or other browser` };
  if (hit.project !== PROJECT) {
    const owner = hit.gate ? `gate pid ${hit.gate.pid}` : 'a gate that is not running';
    return { closed: false, reason: `pid ${pid} belongs to ${owner} for ${hit.project}; close it from that project` };
  }
  if (!hit.gate) return { closed: false, reason: `no gate is running for ${PROJECT}` };
  return closeGate(port, { force, pid });
}

async function settle(pids) {
  const end = Date.now() + 3000;
  let machine = await listBrowsers({ fresh: true });
  while (pids.some((pid) => machine.browsers.some((browser) => browser.pid === pid)) && Date.now() < end) {
    await sleep(200);
    machine = await listBrowsers({ fresh: true });
  }
  return machine;
}

async function runBrowsers(args, port) {
  const { action, target } = args;
  if (action === 'list') return { ok: true, body: { action, browsers: browserReport(await listBrowsers(), PROJECT) } };
  if (action !== 'close') return { ok: false, body: { error: 'action must be "list" or "close"' } };
  const pid = /^pid:(\d+)$/.exec(target ?? '')?.[1];
  if (target !== 'project' && pid === undefined) return { ok: false, body: { error: 'target must be "project" or "pid:<n>"' } };
  const force = args.force === true;
  const outcome = target === 'project'
    ? await closeGate(port, { force })
    : await closePid(Number(pid), force, port, await listBrowsers({ fresh: true }));
  const { closed, ...detail } = outcome;
  const after = await settle(closed && detail.pid ? [detail.pid] : []);
  return {
    ok: true,
    body: {
      action,
      target,
      force,
      closed: closed ? [{ target, ...detail }] : [],
      refused: closed ? [] : [{ target, ...detail }],
      browsers: browserReport(after, PROJECT),
    },
  };
}

function proxyMcp(ports, direct) {
  const pending = new Map();
  const client = { init: { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'playwriter-project', version: '0' } } };
  let child = null;
  let lease = null;
  let idleTimer = null;
  let browserSeen = false;
  let inFlight = 0;
  let finished = false;
  let out = Promise.resolve();
  let forwarded = Promise.resolve();

  const queue = (task) => {
    out = out.then(task).catch((error) => console.error(`playwriter-project: feedback failed: ${error.message}`));
  };
  const write = (msg) => queue(() => process.stdout.write(`${JSON.stringify(msg)}\n`));
  const answer = (msg) => queue(async () => {
    msg.result.content.push({ type: 'text', text: await feedbackText(ports.gate) });
    process.stdout.write(`${JSON.stringify(msg)}\n`);
  });
  const answerBrowsers = (msg) => queue(async () => {
    const { ok, body } = await runBrowsers(msg.params.arguments ?? {}, ports.gate).catch((error) => ({ ok: false, body: { error: error.message } }));
    const content = [{ type: 'text', text: JSON.stringify(body, null, 2) }, { type: 'text', text: await feedbackText(ports.gate) }];
    write({ jsonrpc: '2.0', id: msg.id, result: { content, isError: !ok } });
  });
  const takePending = (id) => {
    const key = JSON.stringify(id);
    const entry = pending.get(key);
    pending.delete(key);
    return entry;
  };

  const finish = (code, signal) => {
    if (finished) return;
    finished = true;
    lease?.then((socket) => socket.destroy(), () => {});
    out.then(() => new Promise((resolve) => process.stdout.write('', resolve))).then(() => process.exit(code ?? (signal ? 1 : 0)));
  };

  const gateLease = () => {
    if (!lease) {
      const pendingLease = acquireLease(ports.gate).catch((error) => {
        if (lease === pendingLease) lease = null;
        throw error;
      });
      lease = pendingLease;
      pendingLease.then((socket) => {
        socket.once('close', () => {
          if (lease === pendingLease) lease = null;
          if (inFlight === 0) retire();
        });
      }, () => {});
    }
    return lease;
  };

  const markBusy = (socket, delta) => httpGet(ports.gate, `/__pwp/busy?id=${socket.leaseId}&delta=${delta}`, 2000);

  const callDone = (ticket) => {
    inFlight -= 1;
    if (ticket.counted) markBusy(ticket.socket, -1);
  };

  const retire = () => {
    clearInterval(idleTimer);
    idleTimer = null;
    browserSeen = false;
    if (child) {
      const retiring = child;
      child = null;
      retiring.stdin.end();
      setTimeout(() => retiring.kill('SIGTERM'), CHILD_EXIT_MS).unref();
    }
    if (lease) {
      const dropped = lease;
      lease = null;
      dropped.then((socket) => socket.destroy(), () => {});
    }
  };

  const checkIdle = async () => {
    if (!child || inFlight > 0) return;
    const status = await httpJson(ports.gate, '/__pwp/status?pages=0', 2000);
    if (status?.browser?.running) browserSeen = true;
    else if (browserSeen && child && inFlight === 0) retire();
  };

  const fromChild = lineReader((line) => {
    const msg = parseFrame(line);
    if (msg?.id === INIT_ID) return;
    const entry = msg?.id === undefined ? undefined : takePending(msg.id);
    if (entry?.method === 'tools/call') {
      callDone(entry.ticket);
      if (Array.isArray(msg.result?.content)) return answer(msg);
    }
    queue(() => process.stdout.write(`${line}\n`));
  });

  const ensureChild = () => {
    if (child) return child;
    const started = playwriterSpawn([], { stdio: ['pipe', 'pipe', 'inherit'], env: { ...process.env, PLAYWRITER_DIRECT: direct } });
    child = started;
    started.stdin.on('error', () => {});
    started.on('error', (error) => {
      console.error(`playwriter-project: ${error.message}`);
      if (started === child) finish(1, null);
    });
    started.on('close', (code, signal) => {
      if (started === child) finish(code, signal);
    });
    started.stdout.setEncoding('utf8');
    started.stdout.on('data', (chunk) => fromChild.push(chunk));
    started.stdout.on('end', () => fromChild.end());
    started.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', id: INIT_ID, method: 'initialize', params: client.init })}\n`);
    started.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', method: 'notifications/initialized' })}\n`);
    idleTimer ??= setInterval(() => {
      checkIdle().catch((error) => console.error(`playwriter-project: idle check failed: ${error.message}`));
    }, IDLE_CHECK_MS);
    idleTimer.unref();
    return started;
  };

  const forward = (line, msg, ticket) => {
    if (msg.method === 'tools/call') inFlight += 1;
    forwarded = forwarded.then(async () => {
      if (msg.method === 'tools/call') {
        ticket.socket = await gateLease();
        await markBusy(ticket.socket, 1);
        ticket.counted = true;
      }
      ensureChild().stdin.write(`${line}\n`);
    }).catch((error) => {
      console.error(`playwriter-project: ${error.message}`);
      if (msg.id !== undefined) write({ jsonrpc: '2.0', id: msg.id, error: { code: -32000, message: error.message } });
      if (msg.method === 'tools/call') callDone(ticket);
    });
  };

  const fromClient = lineReader((line) => {
    const msg = parseFrame(line);
    if (!msg) return;
    if (msg.method === 'initialize' && msg.id !== undefined) {
      client.init = msg.params;
      return write({ jsonrpc: '2.0', id: msg.id, result: MCP_TOOLS.initialize });
    }
    if (msg.method === 'notifications/initialized') return;
    if (msg.method === 'tools/list' && msg.id !== undefined) return write({ jsonrpc: '2.0', id: msg.id, result: { tools: [...MCP_TOOLS.tools, BROWSERS_TOOL] } });
    if (msg.method === 'tools/call' && msg.params?.name === 'browsers' && msg.id !== undefined) return answerBrowsers(msg);
    const ticket = { counted: false, socket: null };
    if (msg.id !== undefined) pending.set(JSON.stringify(msg.id), { method: msg.method, ticket });
    forward(line, msg, ticket);
  });
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', (chunk) => fromClient.push(chunk));
  process.stdin.on('end', () => {
    fromClient.end();
    forwarded.then(() => {
      if (!child) return finish(0, null);
      child.stdin.end();
      setTimeout(() => child.kill('SIGTERM'), CHILD_EXIT_MS).unref();
    });
  });
  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
    process.on(signal, () => (child ? child.kill(signal) : finish(0, null)));
  }
}

async function main(argv) {
  if (argv[0] === '--gate') return runGate(await loadPorts());
  if (argv[0] === 'help' || argv[0] === '--help') return console.log(USAGE);
  if (argv[0] === 'status') return status(argv.includes('--json'));

  const ports = await loadPorts();
  const base = `${HOST}:${ports.gate}`;
  const direct = `ws://${base}/devtools/browser/`;

  if (argv.length === 0) return proxyMcp(ports, direct);

  const lease = await acquireLease(ports.gate);

  if (argv[0] === 'start') {
    const res = await fetch(`http://${base}/json/version`, { signal: AbortSignal.timeout(60000) });
    console.error(res.ok ? `playwriter-project: browser ready (profile ${PROFILE})` : `playwriter-project: browser failed (${res.status})`);
    if (res.ok) await httpGet(ports.gate, `/__pwp/hold?ms=${IDLE_MS}`, 2000);
    lease.destroy();
    process.exit(res.ok ? 0 : 1);
  }

  const newSession = argv[0] === 'session' && (argv.length === 1 || argv[1].startsWith('-'));
  const forwarded = newSession ? ['session', 'new', '--direct', direct, ...argv.slice(1)] : argv;
  const child = playwriterSpawn(forwarded, {
    stdio: 'inherit',
    env: { ...process.env, PLAYWRITER_DIRECT: direct },
  });
  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
    process.on(signal, () => child.kill(signal));
  }
  child.on('error', (error) => {
    console.error(`playwriter-project: ${error.message}`);
    process.exit(1);
  });
  child.on('close', (code, signal) => {
    lease.destroy();
    process.exit(code ?? (signal ? 1 : 0));
  });
}

main(process.argv.slice(2)).catch((error) => {
  console.error(`playwriter-project: error: ${error.message}`);
  process.exit(1);
});
